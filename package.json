{
  "name": "cloudagi-terminal",
  "private": true,
  "version": "0.0.0",
  "description": "CloudAGI. Cloud Agentic Infrastructure monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "bun run --cwd apps/web dev",
    "dev:server": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/server build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run --cwd apps/web typecheck && bun run --cwd apps/server typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": "biome format --write --no-errors-on-unmatched"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CloudAGI-AI/cloudagi-terminal.git"
  }
}
